# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets
.env
.env.*

# Keep environment template
!.env.example

# Raw run traces are large (~150 MB, ~15k files): not committed.
# Only the reproducibility scripts under runs/full/ are tracked.
runs/*
!runs/full/
runs/full/*
!runs/full/run_job.sh
!runs/full/make_jobs.py

# Aggregated CSVs are generated by results/analyze_full.py (not tracked); figures and scripts are tracked.
# results/deck/ holds local slide working files.
results/*.csv
results/report_section_draft.md
results/deck/
*.log

# OS
.DS_Store